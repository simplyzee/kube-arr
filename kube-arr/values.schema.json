        "puid": {
          "type": "integer",
          "minimum": 0
        },
        "pgid": {
          "type": "integer",
          "minimum": 0
        },
        "umask": {
          "type": "string",
          "pattern": "^[0-7]{3,4}$"
        },
        "imagePullSecrets": {
          "type": "array"
        },
        "colocate": {
          "type": "boolean"
        },
